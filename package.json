{
  "name": "yuuka",
  "version": "1.0.0",
  "description": "Discord Gemini 秘書ボット",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:better-sqlite3 --external:discord.js --external:@google/generative-ai --external:googleapis --external:node-cron --external:dotenv",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "better-sqlite3": "^11.8.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.5.0",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
